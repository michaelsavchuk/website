---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;

// TODO: Support for figure and figcaption
---

<div class="post-image">
  <Image
    src={src}
    alt={alt}
    widths={[1440, 720, 360]}
    class="shadow"
    sizes="(max-width: 720px) 100vw, 100vw"
  />
</div>
