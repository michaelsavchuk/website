---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PostList from "../../components/PostList.astro";
import { formatTitle } from "../../helpers/format-title";
---

<SiteLayout
  title={formatTitle("Posts")}
  description="Archive of my latest posts"
  currentNavItem="posts"
  headerTitle="Posts"
>
  <Fragment slot="header-content">
    <p>
      Stay tuned! Follow along on my <a href={new URL("rss.xml", Astro.site)}
        >RSS feed.</a>
    </p>
  </Fragment>

  <PostList />
</SiteLayout>
