---
import SiteLayout from "../layouts/SiteLayout.astro";
import PostList from "../components/PostList.astro";
import ContactLinks from "../components/ContactLinks.astro";
import profile from "../assets/images/me.jpg";
---

<SiteLayout
  title="Michael Savchuk"
  description="I'm a Full-Stack Developer with design skills who’s passionate about building digital experiences that empower and delight."
  headerImage={profile}
  currentNavItem="home"
  headerTitle="Hello,<br>I'm Michael Savchuk."
>
  <Fragment slot="header-content">
    <p>
      I’m a Full-Stack Developer with a background in design, passionate about
      building digital experiences that empower and delight.
    </p>
  </Fragment>

  <div class="vertical-flow">
    <section class="trim-margins">
      <p>
        I have over 6 years of experience creating websites, apps and tools. I
        value thoughtful user experience, good craftsmanship, and productive
        collaboration. I'm always up for a new challenge.
      </p>
      <p>
        Besides working with the web, I love hiking, biking, longboarding, and
        perfecting my coffee brewing technique. I dabble in game development
        too.
      </p>
      <p>Let’s get in touch!</p>
      <ContactLinks />
    </section>
  </div>

  <Fragment slot="footer-content">
    <section class="trim-margins vertical-flow">
      <h2>Latest Posts</h2>
      <PostList limit={4} />
    </section>
  </Fragment>
</SiteLayout>
